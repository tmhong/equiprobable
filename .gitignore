__pycache__/
.pytest_cache/
*.pyc
.DS_Store

# Regenerable result directories (OSDE fits, ML runs, plots, acceptance)
results/osde/
results/osde_*/
results/ml/
results/ml_h170/
results/ml_h2mw/
results/plots/
